{
  "manifest_version": 3,
  "name": "Cookie Inspector – Démo Pédagogique",
  "version": "1.0",
  "description": "Extension pour récupérer et envoyer les cookies d’un site (usage éducatif).",
  "permissions": ["cookies", "activeTab", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cookie Inspector"
  }
}
